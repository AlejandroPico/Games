    "lucide-react": "0.468.0",
    "peerjs": "1.5.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stockfish": "19.0.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "3.7.4",
    "typescript": "~5.9.3",
    "vite": "8.3.1",
    "vitest": "^4.0.0"
  }
