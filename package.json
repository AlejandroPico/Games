{
  "name": "games",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node scripts/prepare-internal.mjs && vite --host 127.0.0.1",
